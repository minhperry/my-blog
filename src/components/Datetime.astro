---
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import IconCalendar from "@/assets/icons/IconCalendar.svg";
import { SITE } from "@/config";

dayjs.extend(utc);
dayjs.extend(timezone);

export interface Props {
  class?: string;
  size?: "sm" | "lg";
  timezone: string | undefined;
  pubDatetime: string | Date;
  modDatetime: string | Date | undefined | null;
}

const {
  pubDatetime,
  modDatetime,
  size = "sm",
  class: className = "",
  timezone: postTimezone,
} = Astro.props;

/* ========== Formatted Datetime ========== */
// const isModified = modDatetime && modDatetime > pubDatetime;

const pubDate = dayjs(pubDatetime).tz(postTimezone || SITE.timezone);
const modDate = modDatetime ? dayjs(modDatetime).tz(postTimezone || SITE.timezone) : null;

const pubDateFormatted = pubDate.format("DD.MM.YYYY"); // e.g., '22.03.2025'
const modDateFormatted = modDate ? modDate.format("DD.MM.YYYY") : null;

// Only show update date if it's on a different day than creation date
const showUpdateDate = modDate && modDate.format("YYYY-MM-DD") !== pubDate.format("YYYY-MM-DD");
---

<div class:list={["flex items-center gap-x-2 opacity-80", className]}>
  <IconCalendar
    class:list={[
      "inline-block size-6 min-w-[1.375rem]",
      { "scale-90": size === "sm" },
    ]}
  />
  <span class:list={["text-sm", { "sm:text-base": size === "lg" }]}>
    <time datetime={pubDate.toISOString()}>{pubDateFormatted}</time>
    {showUpdateDate && (
      <> / U: <time datetime={modDate!.toISOString()}>{modDateFormatted}</time></>
    )}
  </span>
</div>
